{
  "manifest_version": 3,
  "name": "Universal Social Media Video Downloader",
  "version": "1.4.1",
  "description": "Download videos from Facebook, X, Instagram, YouTube, and TikTok, plus TikTok sound",
  "permissions": [
    "downloads",
    "webRequest",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://video.twimg.com/*",
    "https://video-s.twimg.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video downloads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["x-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["x-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://instagram.com/*", "https://*.instagram.com/*"],
      "js": ["ig-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://instagram.com/*", "https://*.instagram.com/*"],
      "js": ["ig-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://youtube.com/*", "https://*.youtube.com/*"],
      "js": ["yt-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tiktok.com/*", "https://*.tiktok.com/*"],
      "js": ["tt-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.facebook.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
